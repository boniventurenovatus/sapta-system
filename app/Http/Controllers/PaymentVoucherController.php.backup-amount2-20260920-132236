<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use App\Models\PaymentVoucher;
use App\Models\Submission;
use App\Models\AuditLog;
use App\Services\WorkflowService;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\DB;
use App\Http\Requests\StorePaymentVoucherRequest;
use App\Http\Requests\UpdatePaymentVoucherRequest;

class PaymentVoucherController extends Controller
{
    protected WorkflowService $workflow;

    public function __construct(WorkflowService $workflow)
    {
        $this->workflow = $workflow;
    }

    public function index(Request $request)
    {
        $query = PaymentVoucher::query()->with(['creator', 'approver']);

        if ($request->filled('status')) {
            $query->where('status', $request->status);
        }
        if ($request->filled('search')) {
            $query->where(function ($q) use ($request) {
                $q->where('voucher_number', 'like', "%{$request->search}%")
                  ->orWhere('payee_name', 'like', "%{$request->search}%");
            });
        }

        $vouchers = $query->orderBy('created_at', 'desc')->paginate(20);

        $stats = [
            'total'    => PaymentVoucher::count(),
            'draft'    => PaymentVoucher::where('status', 'draft')->count(),
            'pending'  => PaymentVoucher::whereIn('status', ['submitted', 'pending_approval'])->count(),
            'approved' => PaymentVoucher::whereIn('status', ['approved', 'paid', 'completed'])->count(),
        ];

        return view('payment-vouchers.index', compact('vouchers', 'stats'));
    }

    public function create()
    {
        $projects = DB::table('projects')->take(50)->get(['id', 'name']);
        $departments = DB::table('departments')->get(['id', 'name']);
        $users = \App\Models\User::orderBy('username')->get(['id', 'username', 'email']);
        return view('payment-vouchers.create', compact('projects', 'departments', 'users'));
    }

    public function store(StorePaymentVoucherRequest $request)
    {
        $action = $request->input('action', 'draft');

        // Validation inafanywa na StorePaymentVoucherRequest
        $validated = $request->validated();

        // Chukua jina la project na department (string) kutoka ID
        $projectName = null;
        if (!empty($validated['project_id'])) {
            $projectName = DB::table('projects')->where('id', $validated['project_id'])->value('name');
        }
        $departmentName = null;
        if (!empty($validated['department_id'])) {
            $departmentName = DB::table('departments')->where('id', $validated['department_id'])->value('name');
        }

        // Auto-generate trans_no + batch
        $svc = app(\App\Services\PaymentVoucherService::class);
        
        $transNo = !empty($validated['trans_no']) ? $validated['trans_no'] : $svc->generateTransNo();
        $batch = $svc->generateBatch();

        $voucher = PaymentVoucher::create([
            'voucher_number' => PaymentVoucher::generateVoucherNumber(),
            'trans_no'       => $transNo,
            'batch'          => $batch,
            'payee_name'     => $validated['payee_name'],
            'payee_type'     => $validated['payee_type'],
            'payee_contact'  => $validated['payee_contact'] ?? null,
            'project_id'     => $validated['project_id'] ?? null,
            'project'        => $projectName,
            'department'     => $departmentName,
            'currency'       => $validated['currency'],
            'amount'         => 0,
            'mode'           => $validated['mode'] ?? null,
            'payment_method' => $validated['mode'] ?? null,
            'payment_date'   => $validated['payment_date'],
            'description'    => $validated['description'] ?? null,
            'notes'          => $validated['notes'] ?? null,
            'created_by'     => Auth::id(),
            'status'         => $action === 'submit' ? 'pending_approval' : 'draft',
            'submitted_at'   => $action === 'submit' ? now() : null,

            // Additional fields
            'payee_pobox'       => $validated['payee_pobox'] ?? null,
            'bank'              => $validated['bank'] ?? null,
            'cheque_number'     => $validated['cheque_number'] ?? null,

            // Signatures
            'prepared_by_id'    => $validated['prepared_by_id'] ?? Auth::id(),
            'prepared_at'       => $validated['prepared_at'] ?? now(),
            'checked_by_id'     => $validated['checked_by_id'] ?? null,
            'checked_at'        => $validated['checked_at'] ?? null,
            'authorized_by_id'  => $validated['authorized_by_id'] ?? null,
            'authorized_at'     => $validated['authorized_at'] ?? null,
            'received_by_name'  => $validated['received_by_name'] ?? null,
        ]);

        // Hifadhi line items
        $totalAmount = 0;
        foreach (($validated['items'] ?? []) as $index => $item) {
            $voucher->items()->create([
                'account_invoice_no' => $item['account_invoice_no'] ?? null,
                'details'            => $item['details'],
                'amount'             => $item['amount'],
                'sort_order'         => $index,
            ]);
            $totalAmount += (float) $item['amount'];
        }

        // Update total na amount_in_words
        $svc = app(\App\Services\PaymentVoucherService::class);
        $voucher->update([
            'amount'          => $totalAmount,
            'amount_in_words' => $svc->amountInWords($totalAmount, $voucher->currency ?? 'TZS'),
        ]);

        AuditLog::create([
            'auditable_type'  => PaymentVoucher::class,
            'auditable_id'    => $voucher->id,
            'user_id'         => Auth::id(),
            'action'          => $action === 'submit' ? 'submitted' : 'created',
            'previous_status' => null,
            'new_status'      => $voucher->status,
            'comment'         => $action === 'submit' ? 'Payment voucher submitted for approval' : 'Payment voucher saved as draft',
            'ip_address'      => $request->ip(),
            'user_agent'      => $request->userAgent(),
        ]);

        if ($action === 'submit') {
            $this->workflow->submit(
                formType: 'payment_voucher',
                title: 'Payment Voucher ' . $voucher->voucher_number . ' — ' . $voucher->payee_name,
                data: $voucher->toArray(),
                submittableType: PaymentVoucher::class,
                submittableId: $voucher->id
            );

            return redirect()->route('payment-vouchers.show', $voucher->id)
                ->with('success', 'Payment Voucher ' . $voucher->voucher_number . ' submitted successfully for approval!');
        }

        return redirect()->route('payment-vouchers.show', $voucher->id)
            ->with('success', 'Payment Voucher ' . $voucher->voucher_number . ' saved as draft successfully!');
    }

    public function show(PaymentVoucher $paymentVoucher)
    {
        $submission = Submission::where('submittable_type', PaymentVoucher::class)
            ->where('submittable_id', $paymentVoucher->id)
            ->first();

        $versions = $submission ? $submission->versions : collect();
        $auditLogs = AuditLog::where('auditable_type', PaymentVoucher::class)
            ->where('auditable_id', $paymentVoucher->id)
            ->with('user')
            ->orderBy('created_at', 'desc')
            ->get();

        return view('payment-vouchers.show', ['voucher' => $paymentVoucher, 'versions' => $versions, 'auditLogs' => $auditLogs]);
    }

    public function edit(PaymentVoucher $paymentVoucher)
    {
        if (!in_array($paymentVoucher->status, ['draft', 'returned'])) {
            return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
                ->with('error', 'Only drafts and returned vouchers can be edited.');
        }

        $projects = DB::table('projects')->take(50)->get(['id', 'name']);
        $departments = DB::table('departments')->get(['id', 'name']);
        $users = \App\Models\User::orderBy('username')->get(['id', 'username', 'email']);
        return view('payment-vouchers.edit', compact('paymentVoucher', 'projects', 'departments', 'users'));
    }

    public function update(UpdatePaymentVoucherRequest $request, PaymentVoucher $paymentVoucher)
    {
        $action = $request->input('action', 'draft');

        // Validation inafanywa na StorePaymentVoucherRequest
        $validated = $request->validated();

        // Chukua jina la project na department
        $projectName = $paymentVoucher->project;
        if (!empty($validated['project_id']) && $validated['project_id'] != $paymentVoucher->project_id) {
            $projectName = DB::table('projects')->where('id', $validated['project_id'])->value('name');
        }
        $departmentName = $paymentVoucher->department;
        if (!empty($validated['department_id']) && $validated['department_id'] != $paymentVoucher->department_id) {
            $departmentName = DB::table('departments')->where('id', $validated['department_id'])->value('name');
        }

        $status = $paymentVoucher->status;
        $submittedAt = $paymentVoucher->submitted_at;

        if ($action === 'submit') {
            $status = 'pending_approval';
            $submittedAt = now();
        }

        // Auto-generate trans_no + batch (kama hazipo)
        $svc = app(\App\Services\PaymentVoucherService::class);
        
        $transNo = $paymentVoucher->trans_no ?? $svc->generateTransNo();
        $batch = $paymentVoucher->batch ?? $svc->generateBatch();

        $paymentVoucher->update([
            // Auto-generated
            'trans_no'          => $transNo,
            'batch'             => $batch,

            // Header
            'payment_date'      => $validated['payment_date'],
            'currency'          => $validated['currency'],
            'payee_name'        => $validated['payee_name'],
            'payee_pobox'       => $validated['payee_pobox'] ?? null,
            'payee_type'        => $validated['payee_type'],
            'payee_contact'     => $validated['payee_contact'] ?? null,
            'bank'              => $validated['bank'] ?? null,
            'mode'              => $validated['mode'] ?? null,
            'payment_method'    => $validated['mode'] ?? null,
            'cheque_number'     => $validated['cheque_number'] ?? null,

            // Project / Department
            'project_id'        => $validated['project_id'] ?? null,
            'project'           => $projectName,
            'department'        => $departmentName,

            // Signatures
            'prepared_by_id'    => $validated['prepared_by_id'] ?? $paymentVoucher->prepared_by_id,
            'prepared_at'       => $validated['prepared_at'] ?? $paymentVoucher->prepared_at,
            'checked_by_id'     => $validated['checked_by_id'] ?? null,
            'checked_at'        => $validated['checked_at'] ?? null,
            'authorized_by_id'  => $validated['authorized_by_id'] ?? null,
            'authorized_at'     => $validated['authorized_at'] ?? null,
            'received_by_name'  => $validated['received_by_name'] ?? null,

            // Notes
            'description'       => $validated['description'] ?? null,
            'notes'             => $validated['notes'] ?? null,

            // Workflow
            'status'            => $status,
            'submitted_at'      => $submittedAt,
        ]);

        // Sync line items: futa zote za zamani, kisha unda mpya
        $paymentVoucher->items()->delete();

        $totalAmount = 0;
        foreach (($validated['items'] ?? []) as $index => $item) {
            $paymentVoucher->items()->create([
                'account_invoice_no' => $item['account_invoice_no'] ?? null,
                'details'            => $item['details'],
                'amount'             => $item['amount'],
                'sort_order'         => $index,
            ]);
            $totalAmount += (float) $item['amount'];
        }

        // Update total na amount_in_words
        $svc = app(\App\Services\PaymentVoucherService::class);
        $paymentVoucher->update([
            'amount'          => $totalAmount,
            'amount_in_words' => $svc->amountInWords($totalAmount, $paymentVoucher->currency ?? 'TZS'),
        ]);

        if ($action === 'submit') {
            $submission = Submission::where('submittable_type', PaymentVoucher::class)
                ->where('submittable_id', $paymentVoucher->id)
                ->first();

            if ($submission && $paymentVoucher->getOriginal('status') === 'returned') {
                $this->workflow->resubmit($submission, $paymentVoucher->toArray());
            } elseif (!$submission) {
                $this->workflow->submit(
                    formType: 'payment_voucher',
                    title: 'Payment Voucher ' . $paymentVoucher->voucher_number,
                    data: $paymentVoucher->toArray(),
                    submittableType: PaymentVoucher::class,
                    submittableId: $paymentVoucher->id
                );
            }

            return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
                ->with('success', 'Payment Voucher submitted successfully for approval!');
        }

        return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
            ->with('success', 'Payment Voucher updated successfully!');
    }

    public function approve(Request $request, PaymentVoucher $paymentVoucher)
    {
        $paymentVoucher->update([
            'status' => 'approved',
            'approved_by' => Auth::id(),
            'approved_at' => now(),
        ]);

        $submission = Submission::where('submittable_type', PaymentVoucher::class)
            ->where('submittable_id', $paymentVoucher->id)
            ->first();

        if ($submission) {
            $this->workflow->approve($submission, $request->input('comment'));
        }

        return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
            ->with('success', 'Payment Voucher approved successfully!');
    }

    public function returnVoucher(Request $request, PaymentVoucher $paymentVoucher)
    {
        $request->validate(['reason' => 'required|string|max:1000']);

        $paymentVoucher->update([
            'status' => 'returned',
            'return_reason' => $request->reason,
        ]);

        $submission = Submission::where('submittable_type', PaymentVoucher::class)
            ->where('submittable_id', $paymentVoucher->id)
            ->first();

        if ($submission) {
            $this->workflow->returnForCorrection($submission, $request->reason);
        }

        return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
            ->with('success', 'Payment Voucher returned for correction.');
    }

    

    /**
     * Mark voucher as Checked.
     */
    public function check(Request $request, PaymentVoucher $paymentVoucher)
    {
        abort_unless(auth()->user()->hasAnyRole(['super_admin','admin','finance_manager','accountant','director']), 403);
        $paymentVoucher->update(['checked_by_id' => auth()->id(), 'checked_at' => now(), 'status' => 'checked']);
        return back()->with('success', 'Voucher checked successfully.');
    }

    /**
     * Mark voucher as Authorized.
     */
    public function authorizeVoucher(Request $request, PaymentVoucher $paymentVoucher)
    {
        abort_unless(auth()->user()->hasAnyRole(['super_admin','admin','director','ceo']), 403);
        $paymentVoucher->update(['authorized_by_id' => auth()->id(), 'authorized_at' => now(), 'status' => 'authorized']);
        return back()->with('success', 'Voucher authorized successfully.');
    }

public function markPaid(PaymentVoucher $paymentVoucher)
    {
        $paymentVoucher->update([
            'status' => 'paid',
            'paid_at' => now(),
        ]);

        return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
            ->with('success', 'Payment Voucher marked as paid successfully!');
    }

    public function destroy(PaymentVoucher $paymentVoucher)
    {
        $paymentVoucher->delete();
        return redirect()->route('payment-vouchers.index')
            ->with('success', 'Payment Voucher deleted successfully.');
    }

    public function downloadPdf(PaymentVoucher $paymentVoucher)
    {
        if (!class_exists('Barryvdh\DomPDF\Facade\Pdf')) {
            return back()->with('error', 'PDF package haipo. Endesha: composer require barryvdh/laravel-dompdf');
        }

        $data = [
            'voucher'    => $paymentVoucher,
            'creator'    => $paymentVoucher->creator,
            'approver'   => $paymentVoucher->approver,
            'project'    => $paymentVoucher->project_id ? DB::table('projects')->where('id', $paymentVoucher->project_id)->first() : null,
            'department' => DB::table('departments')->where('name', $paymentVoucher->department)->first(),
            'generated_at' => now(),
        ];

        $pdf = \Barryvdh\DomPDF\Facade\Pdf::loadView('payment-vouchers.pdf', ['voucher' => $paymentVoucher]);
        $pdf->setPaper('A4', 'portrait');

        return $pdf->download('Payment-Voucher-' . $paymentVoucher->voucher_number . '.pdf');
    }

    public function print(PaymentVoucher $paymentVoucher)
    {
        $data = [
            'voucher'    => $paymentVoucher,
            'creator'    => $paymentVoucher->creator,
            'approver'   => $paymentVoucher->approver,
            'project'    => $paymentVoucher->project_id ? DB::table('projects')->where('id', $paymentVoucher->project_id)->first() : null,
            'department' => DB::table('departments')->where('name', $paymentVoucher->department)->first(),
            'generated_at' => now(),
        ];

        return view('payment-vouchers.print', ['voucher' => $paymentVoucher]);
    }
}