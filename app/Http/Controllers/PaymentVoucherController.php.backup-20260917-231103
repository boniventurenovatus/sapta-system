<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use App\Models\PaymentVoucher;
use App\Models\Submission;
use App\Services\WorkflowService;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\DB;

class PaymentVoucherController extends Controller
{
    protected WorkflowService $workflow;

    public function __construct(WorkflowService $workflow)
    {
        $this->workflow = $workflow;
    }

    public function index(Request $request)
    {
        $query = PaymentVoucher::query()->with(['creator', 'approver']);

        if ($request->filled('status')) {
            $query->where('status', $request->status);
        }
        if ($request->filled('search')) {
            $query->where(function ($q) use ($request) {
                $q->where('voucher_number', 'like', "%{$request->search}%")
                  ->orWhere('payee_name', 'like', "%{$request->search}%");
            });
        }

        $vouchers = $query->orderBy('created_at', 'desc')->paginate(20);

        $stats = [
            'total'    => PaymentVoucher::count(),
            'draft'    => PaymentVoucher::where('status', 'draft')->count(),
            'pending'  => PaymentVoucher::whereIn('status', ['submitted', 'pending_approval'])->count(),
            'approved' => PaymentVoucher::whereIn('status', ['approved', 'paid', 'completed'])->count(),
        ];

        return view('payment-vouchers.index', compact('vouchers', 'stats'));
    }

    public function create()
    {
        $projects = DB::table('projects')->take(50)->get(['id', 'name']);
        $departments = DB::table('departments')->get(['id', 'name']);
        return view('payment-vouchers.create', compact('projects', 'departments'));
    }

    public function store(Request $request)
    {
        $action = $request->input('action', 'draft');

        $validated = $request->validate([
            'payee_name'     => 'required|string|max:255',
            'payee_type'     => 'required|in:individual,company,government,ngo',
            'payee_contact'  => 'nullable|string|max:255',
            'amount'         => 'required|numeric|min:0.01',
            'currency'       => 'required|string|max:10',
            'payment_method' => 'required|in:bank_transfer,cash,cheque,mobile_money',
            'project_id'     => 'nullable|integer',
            'department_id'  => 'nullable|integer',
            'voucher_date'   => 'required|date',
            'description'    => 'nullable|string|max:2000',
            'notes'          => 'nullable|string|max:2000',
        ]);

        $validated['voucher_number'] = PaymentVoucher::generateVoucherNumber();
        $validated['prepared_by'] = Auth::id();
        $validated['status'] = $action === 'submit' ? 'pending_approval' : 'draft';

        $voucher = PaymentVoucher::create($validated);

        if ($action === 'submit') {
            $this->workflow->submit(
                formType: 'payment_voucher',
                title: 'Payment Voucher ' . $voucher->voucher_number . ' — ' . $voucher->payee_name,
                data: $voucher->toArray(),
                submittableType: PaymentVoucher::class,
                submittableId: $voucher->id
            );

            return redirect()->route('payment-vouchers.show', $voucher->id)
                ->with('success', 'Payment Voucher submitted: ' . $voucher->voucher_number);
        }

        return redirect()->route('payment-vouchers.show', $voucher->id)
            ->with('success', 'Payment Voucher saved as draft: ' . $voucher->voucher_number);
    }

    public function show(PaymentVoucher $paymentVoucher)
    {
        $submission = Submission::where('submittable_type', PaymentVoucher::class)
            ->where('submittable_id', $paymentVoucher->id)
            ->first();

        $versions = $submission ? $submission->versions : collect();
        $auditLogs = \App\Models\AuditLog::where('auditable_type', PaymentVoucher::class)
            ->where('auditable_id', $paymentVoucher->id)
            ->with('user')
            ->orderBy('created_at', 'desc')
            ->get();

        return view('payment-vouchers.show', compact('paymentVoucher', 'versions', 'auditLogs'));
    }

    public function edit(PaymentVoucher $paymentVoucher)
    {
        if (!in_array($paymentVoucher->status, ['draft', 'returned'])) {
            return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
                ->with('error', 'Only drafts and returned vouchers can be edited.');
        }

        $projects = DB::table('projects')->take(50)->get(['id', 'name']);
        $departments = DB::table('departments')->get(['id', 'name']);
        return view('payment-vouchers.edit', compact('paymentVoucher', 'projects', 'departments'));
    }

    public function update(Request $request, PaymentVoucher $paymentVoucher)
    {
        $action = $request->input('action', 'draft');

        $validated = $request->validate([
            'payee_name'     => 'required|string|max:255',
            'payee_type'     => 'required|in:individual,company,government,ngo',
            'payee_contact'  => 'nullable|string|max:255',
            'amount'         => 'required|numeric|min:0.01',
            'currency'       => 'required|string|max:10',
            'payment_method' => 'required|in:bank_transfer,cash,cheque,mobile_money',
            'project_id'     => 'nullable|integer',
            'department_id'  => 'nullable|integer',
            'voucher_date'   => 'required|date',
            'description'    => 'nullable|string|max:2000',
            'notes'          => 'nullable|string|max:2000',
        ]);

        if ($action === 'submit') {
            $validated['status'] = 'pending_approval';

            $submission = Submission::where('submittable_type', PaymentVoucher::class)
                ->where('submittable_id', $paymentVoucher->id)
                ->first();

            if ($submission && $paymentVoucher->status === 'returned') {
                $this->workflow->resubmit($submission, $validated);
            } elseif (!$submission) {
                $this->workflow->submit(
                    formType: 'payment_voucher',
                    title: 'Payment Voucher ' . $paymentVoucher->voucher_number,
                    data: $validated,
                    submittableType: PaymentVoucher::class,
                    submittableId: $paymentVoucher->id
                );
            }

            $paymentVoucher->update($validated);

            return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
                ->with('success', 'Payment Voucher submitted for approval.');
        }

        $paymentVoucher->update($validated);

        return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
            ->with('success', 'Payment Voucher updated successfully.');
    }

    public function approve(Request $request, PaymentVoucher $paymentVoucher)
    {
        $paymentVoucher->update([
            'status' => 'approved',
            'approved_by' => Auth::id(),
            'approved_at' => now(),
        ]);

        $submission = Submission::where('submittable_type', PaymentVoucher::class)
            ->where('submittable_id', $paymentVoucher->id)
            ->first();

        if ($submission) {
            $this->workflow->approve($submission, $request->input('comment'));
        }

        return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
            ->with('success', 'Payment Voucher approved successfully.');
    }

    public function returnVoucher(Request $request, PaymentVoucher $paymentVoucher)
    {
        $request->validate(['reason' => 'required|string|max:1000']);

        $paymentVoucher->update([
            'status' => 'returned',
            'rejection_reason' => $request->reason,
        ]);

        $submission = Submission::where('submittable_type', PaymentVoucher::class)
            ->where('submittable_id', $paymentVoucher->id)
            ->first();

        if ($submission) {
            $this->workflow->returnForCorrection($submission, $request->reason);
        }

        return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
            ->with('success', 'Payment Voucher returned for correction.');
    }

    public function markPaid(PaymentVoucher $paymentVoucher)
    {
        $paymentVoucher->update([
            'status' => 'paid',
            'paid_at' => now(),
        ]);

        return redirect()->route('payment-vouchers.show', $paymentVoucher->id)
            ->with('success', 'Payment Voucher marked as paid.');
    }

    public function destroy(PaymentVoucher $paymentVoucher)
    {
        $paymentVoucher->delete();
        return redirect()->route('payment-vouchers.index')
            ->with('success', 'Payment Voucher deleted successfully.');
    }
}