    <td>{{ $voucher->checked_at ? \Carbon\Carbon::parse($voucher->checked_at)->format('d/m/Y') : '' }}</td>
</tr>
<tr>
    <td><div class="sig-label">Authorized By:</div><div class="sig-name">{{ $voucher->authorizedBy->username ?? '-' }}</div></td>
    <td></td>
    <td>{{ $voucher->authorized_at ? \Carbon\Carbon::parse($voucher->authorized_at)->format('d/m/Y') : '' }}</td>
</tr>
</tbody>
</table>

{{-- RECEIVED BY --}}
<table class="received-table">
<tr>
    <td class="label">Received BY:</td>
    <td class="value">{{ $voucher->received_by_name ?? '' }}</td>
