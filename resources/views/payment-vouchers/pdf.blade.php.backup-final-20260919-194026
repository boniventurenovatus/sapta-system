<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Payment Voucher</title>
<style>
@page { size: A4 landscape; margin: 5mm; }
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: Arial, sans-serif; font-size: 10pt; color: #000; margin: 0; padding: 0; }

.container { width: calc(100% - 10mm); margin: 0 auto; padding: 4mm 3mm; border: 2px solid #000; box-sizing: border-box; }

/* HEADER */
.header { text-align: center; border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 12px; }
.header .title { font-size: 18pt; font-weight: bold; letter-spacing: 3px; margin-bottom: 4px; }
.header .org { font-size: 11pt; font-weight: bold; margin-bottom: 2px; }
.header .address { font-size: 9pt; margin-bottom: 6px; }
.header img { height: 70px; width: auto; display: block; margin: 0 auto; }

/* INFO TABLE */
.info-table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
.info-table td { padding: 4px 2px; vertical-align: top; font-size: 10pt; }
.info-table td.label { font-weight: bold; white-space: nowrap; width: 15%; }
.info-table td.value { border-bottom: 1px dotted #666; padding-left: 4px; width: 35%; }
.info-table td.label2 { font-weight: bold; white-space: nowrap; padding-left: 12px; width: 15%; }
.info-table td.value2 { border-bottom: 1px dotted #666; padding-left: 4px; width: 35%; }

/* ITEMS TABLE */
.items-table { width: 100%; border-collapse: collapse; margin: 0; }
.items-table thead th { background: #f0f0f0; font-weight: bold; font-size: 9pt; text-align: left; padding: 5px 4px; border: 1px solid #000; }
.items-table thead th:last-child { border-right: none; text-align: right; }
.items-table tbody td { padding: 5px 4px; border: 1px solid #000; font-size: 9pt; vertical-align: top; word-wrap: break-word; }
.items-table tbody td:last-child { border-right: none; text-align: right; }
.items-table .col-account { width: 20%; }
.items-table .col-details { width: 60%; }
.items-table .col-amount { width: 20%; text-align: right; }
.items-table tfoot td { padding: 6px 4px; font-size: 9pt; vertical-align: top; border: 1px solid #000; }
.items-table tfoot td:last-child { border-right: none; text-align: right; }

.amount-words-label { font-weight: bold; font-size: 10pt; margin-bottom: 2px; }
.amount-words-value { font-size: 10pt; }
.total-label { font-weight: bold; font-size: 11pt; margin-bottom: 2px; }
.total-value { font-weight: bold; font-size: 13pt; }

/* SIGNATURES TABLE */
.signatures-table { width: 100%; border-collapse: collapse; margin-top: 0; }
.signatures-table thead th { background: #f0f0f0; font-weight: bold; font-size: 9pt; text-align: left; padding: 5px 4px; border: 1px solid #000; }
.signatures-table thead th:last-child { border-right: none; }
.signatures-table tbody td { padding: 10px 4px; border: 1px solid #000; font-size: 9pt; vertical-align: top; height: 40px; }
.signatures-table tbody td:last-child { border-right: none; }
.signatures-table tbody tr:last-child td { border-bottom: none; }
.sig-label { font-weight: bold; font-size: 9pt; }
.sig-name { font-size: 10pt; margin-top: 2px; }

/* RECEIVED BY */
.received-table { width: 100%; border-collapse: collapse; margin-top: 12px; }
.received-table td { padding: 4px 0; vertical-align: bottom; font-size: 10pt; }
.received-table td.label { font-weight: bold; white-space: nowrap; width: 12%; }
.received-table td.value { border-bottom: 1px solid #000; padding-left: 4px; width: 38%; }
.received-table td.gap { width: 4%; }
</style>
</head>
<body>
<div class="container">

{{-- HEADER --}}
