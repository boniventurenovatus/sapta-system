    private function monthlyRevenue(): array
    {
        $months = [];
        $data = [];

        for ($i = 11; $i >= 0; $i--) {
            $month = now()->subMonths($i);
            $months[] = $month->format('M Y');
            $data[] = (float) \Schema::hasTable('payment_vouchers') ? PaymentVoucher::whereYear('created_at', $month->year)
                ->whereMonth('created_at', $month->month)
                ->where('status', 'paid')
                ->sum('amount');
        }

        return [
            'labels' => $months,
            'datasets' => [[
                'label' => 'Revenue (TZS)',
                'data' => $data,
                'borderColor' => '#2563eb',
                'backgroundColor' => 'rgba(37, 99, 235, 0.1)',
                'fill' => true,
                'tension' => 0.4,
            ]],
        ];
    }

