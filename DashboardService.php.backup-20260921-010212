            'labels' => $projects->pluck('name')->map(fn($n) => \Str::limit($n, 25))->toArray(),
            'datasets' => [[
                'label' => 'Budget (TZS)',
                'data' => $projects->pluck('budget')->map(fn($v) => (float) $v)->toArray(),
                'backgroundColor' => '#10b981',
                'borderRadius' => 6,
            ]],
        ];
    }

    private function monthlyReports(): array
    {
        $months = [];
        $data = [];

        for ($i = 5; $i >= 0; $i--) {
            $month = now()->subMonths($i);
            $months[] = $month->format('M Y');
            $data[] = Document::where('category', 'report')
                ->whereYear('created_at', $month->year)
                ->whereMonth('created_at', $month->month)
                ->count();
        }

        return [
            'labels' => $months,
            'datasets' => [[
                'label' => 'Reports',
                'data' => $data,
                'backgroundColor' => '#3b82f6',
                'borderRadius' => 6,
            ]],
        ];
    }

    private function monthlyPerformance(): array
    {
        $months = [];
        $tasks = [];

        for ($i = 5; $i >= 0; $i--) {
            $month = now()->subMonths($i);
            $months[] = $month->format('M');
            $tasks[] = \Schema::hasTable('tasks') ? Task::where('status', 'done')
                ->whereYear('created_at', $month->year)
                ->whereMonth('created_at', $month->month)
                ->count();
        }

        return [
            'labels' => $months,
            'datasets' => [[
                'label' => 'Tasks Completed',
                'data' => $tasks,
                'borderColor' => '#10b981',
                'backgroundColor' => 'rgba(16, 185, 129, 0.1)',
                'fill' => true,
                'tension' => 0.4,
            ]],
        ];
    }

    private function topProjects(): array
    {
        return \Schema::hasTable('projects') ? Project::orderBy('budget', 'desc')->take(5)->get()->toArray();
    }

    private function recentActivities(): array
    {
        return \Schema::hasTable('audit_logs')
            ? \App\Models\AuditLog::with('user')
                ->orderBy('created_at', 'desc')
                ->take(10)
                ->get()
                ->toArray()
            : [];
    }
}
