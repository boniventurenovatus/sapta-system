    private function myAttendanceChart($employeeId): array
    {
        $months = [];
        $present = [];
        $absent = [];

        for ($i = 5; $i >= 0; $i--) {
            $month = now()->subMonths($i);
            $months[] = $month->format('M');

            $present[] = \App\Models\\Schema::hasTable('attendances') ? Attendance::where('employee_id', $employeeId)
                ->whereYear('created_at', $month->year)
                ->whereMonth('created_at', $month->month)
                ->where('status', 'present')
                ->count();

            $absent[] = \App\Models\\Schema::hasTable('attendances') ? Attendance::where('employee_id', $employeeId)
                ->whereYear('created_at', $month->year)
                ->whereMonth('created_at', $month->month)
                ->where('status', 'absent')
                ->count();
        }

        return [
            'labels' => $months,
            'datasets' => [
                [
                    'label' => 'Present',
                    'data' => $present,
                    'backgroundColor' => '#10b981',
                    'borderRadius' => 6,
                ],
                [
                    'label' => 'Absent',
                    'data' => $absent,
                    'backgroundColor' => '#ef4444',
                    'borderRadius' => 6,
                ],
            ],
        ];
    }

