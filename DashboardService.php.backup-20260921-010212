     * ==============================================================
     */
    private function budgetUtilization(): float
    {
        $allocated = Budget::sum('allocated_amount');
        $spent = Budget::sum('spent_amount');
        return $allocated > 0 ? round(($spent / $allocated) * 100, 1) : 0;
    }

    private function pendingApprovals(): int
    {
        return \Schema::hasTable('payment_vouchers') ? PaymentVoucher::whereIn('status', ['pending_approval', 'submitted'])->count()
            + \Schema::hasTable('leave_requests') ? LeaveRequest::where('status', 'pending')->count()
            + ExpenseClaim::whereIn('status', ['pending_approval', 'submitted'])->count()
            + ProcurementRequest::where('status', 'pending')->count();
    }

    private function budgetVsActual(): array
    {
        $budgets = Budget::select('category', DB::raw('SUM(allocated_amount) as allocated'), DB::raw('SUM(spent_amount) as spent'))
            ->groupBy('category')
            ->take(8)
            ->get();

        return [
            'labels' => $budgets->pluck('category')->toArray(),
            'datasets' => [
                [
                    'label' => 'Allocated',
                    'data' => $budgets->pluck('allocated')->map(fn($v) => (float) $v)->toArray(),
                    'backgroundColor' => '#2563eb',
                    'borderRadius' => 6,
                ],
                [
                    'label' => 'Spent',
                    'data' => $budgets->pluck('spent')->map(fn($v) => (float) $v)->toArray(),
                    'backgroundColor' => '#10b981',
                    'borderRadius' => 6,
                ],
            ],
        ];
    }

