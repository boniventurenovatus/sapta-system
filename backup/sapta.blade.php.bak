{{-- =============================================================
DELETE MODAL
============================================================= --}}

<div
    id="deleteModal"
    class="delete-modal-overlay"
    aria-hidden="true"
>

    <div
        class="delete-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="deleteModalTitle"
    >

        <div class="delete-modal-icon">

            <svg
                width="27"
                height="27"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M10.3 3.2 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.2a2 2 0 0 0-3.4 0Z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>

        </div>


        <h2 id="deleteModalTitle">
            Delete this record?
        </h2>


        <p>

            Are you sure you want to permanently delete

            <span
                id="deleteUserName"
                class="delete-user-name"
            >
                this record
            </span>

            ?

        </p>


        <div class="delete-modal-actions">

            <button
                type="button"
                id="deleteCancelButton"
                class="delete-cancel-btn"
            >
                Cancel
            </button>

            <button
                type="button"
                id="deleteConfirmButton"
                class="delete-confirm-btn"
            >
                Yes, Delete
            </button>

        </div>

    </div>

</div>

<script>

    /* =========================================================
       SIDEBAR MENUS
    ========================================================= */

    function toggleSidebarMenu(menuId, button) {

        const menu =
            document.getElementById(menuId);

        if (!menu) {
            return;
        }

        const isOpen =
            menu.classList.contains('open');


        /*
         * Close other open menus.
         */

        document
            .querySelectorAll('.sidebar-submenu.open')
            .forEach(function (otherMenu) {

                if (otherMenu.id !== menuId) {

                    otherMenu.classList.remove('open');

                    const otherButton =
                        otherMenu
                            .previousElementSibling;

                    if (otherButton) {

                        const otherChevron =
                            otherButton.querySelector(
                                '.sidebar-chevron'
                            );

                        if (otherChevron) {
                            otherChevron.classList.remove('rotate');
                        }

                    }

                }

            });


        /*
         * Toggle current menu.
         */

        if (isOpen) {

            menu.classList.remove('open');

        } else {

            menu.classList.add('open');

        }


        const chevron =
            button.querySelector('.sidebar-chevron');

        if (chevron) {

            chevron.classList.toggle(
                'rotate',
                !isOpen
            );

        }

    }


    /* =========================================================
       MOBILE SIDEBAR
    ========================================================= */

    function openMobileSidebar() {

        const sidebar =
            document.getElementById(
                'saptaSidebar'
            );

        const overlay =
            document.getElementById(
                'saptaSidebarOverlay'
            );

        if (sidebar) {
            sidebar.classList.add(
                'mobile-open'
            );
        }

        if (overlay) {
            overlay.classList.add(
                'show'
            );
        }

        document.body.style.overflow =
            'hidden';

    }


    function closeMobileSidebar() {

        const sidebar =
            document.getElementById(
                'saptaSidebar'
            );

        const overlay =
            document.getElementById(
                'saptaSidebarOverlay'
            );

        if (sidebar) {
            sidebar.classList.remove(
                'mobile-open'
            );
        }

        if (overlay) {
            overlay.classList.remove(
                'show'
            );
        }

        document.body.style.overflow =
            '';

    }


    /* =========================================================
       CLOSE MOBILE SIDEBAR AFTER LINK
    ========================================================= */

    document.addEventListener(
        'click',
        function (event) {

            const link =
                event.target.closest(
                    '.sidebar-submenu-link, .sidebar-single-link'
                );

            if (!link) {
                return;
            }

            if (window.innerWidth <= 768) {
                closeMobileSidebar();
            }

        }
    );


    /* =========================================================
       ESCAPE MOBILE SIDEBAR
    ========================================================= */

    document.addEventListener(
        'keydown',
        function (event) {

            if (event.key === 'Escape') {

                closeMobileSidebar();

            }

        }
    );


    /* =========================================================
       TOAST
    ========================================================= */

    function closeSaptaToast(button) {

        const toast =
            button.closest(
                '.sapta-toast'
            );

        if (!toast) {
            return;
        }

        toast.classList.add('hide');

        setTimeout(
            function () {

                toast.remove();

            },
            250
        );

    }


    document.addEventListener(
        'DOMContentLoaded',
        function () {

            document
                .querySelectorAll('.sapta-toast')
                .forEach(
                    function (toast) {

                        setTimeout(
                            function () {

                                if (
                                    !toast.classList.contains(
                                        'hide'
                                    )
                                ) {

                                    toast.classList.add(
                                        'hide'
                                    );

                                    setTimeout(
                                        function () {

                                            toast.remove();

                                        },
                                        250
                                    );

                                }

                            },
                            5000
                        );

                    }
                );

        }
    );


    /* =========================================================
       DELETE MODAL
    ========================================================= */

    document.addEventListener(
        'DOMContentLoaded',
        function () {

            const modal =
                document.getElementById(
                    'deleteModal'
                );

            const userName =
                document.getElementById(
                    'deleteUserName'
                );

            const cancelButton =
                document.getElementById(
                    'deleteCancelButton'
                );

            const confirmButton =
                document.getElementById(
                    'deleteConfirmButton'
                );

            if (
                !modal ||
                !userName ||
                !cancelButton ||
                !confirmButton
            ) {
                return;
            }


            let selectedForm = null;


            /* -------------------------------------------------
               OPEN MODAL
            ------------------------------------------------- */

            document.addEventListener(
                'click',
                function (event) {

                    const deleteButton =
                        event.target.closest(
                            '[data-delete-button]'
                        );

                    if (!deleteButton) {
                        return;
                    }

                    event.preventDefault();


                    selectedForm =
                        deleteButton.closest(
                            'form'
                        );

                    if (!selectedForm) {
                        return;
                    }


                    const name =
                        deleteButton.dataset.userName
                        ||
                        selectedForm.dataset.userName
                        ||
                        'this record';


                    const type =
                        deleteButton.dataset.deleteType
                        ||
                        selectedForm.dataset.deleteType
                        ||
                        'record';


                    userName.textContent =
                        name;


                    document.getElementById(
                        'deleteModalTitle'
                    ).textContent =
                        `Delete this ${type}?`;


                    modal.classList.add(
                        'show'
                    );

                    modal.setAttribute(
                        'aria-hidden',
                        'false'
                    );

                    document.body.style.overflow =
                        'hidden';

                }
            );


            /* -------------------------------------------------
               CANCEL
            ------------------------------------------------- */

            cancelButton.addEventListener(
                'click',
                closeDeleteModal
            );


            /* -------------------------------------------------
               CONFIRM
            ------------------------------------------------- */

            confirmButton.addEventListener(
                'click',
                function () {

                    if (!selectedForm) {
                        return;
                    }

                    confirmButton.disabled =
                        true;

                    confirmButton.textContent =
                        'Deleting...';

                    selectedForm.submit();

                }
            );


            /* -------------------------------------------------
               OUTSIDE CLICK
            ------------------------------------------------- */

            modal.addEventListener(
                'click',
                function (event) {

                    if (
                        event.target === modal
                    ) {

                        closeDeleteModal();

                    }

                }
            );


            /* -------------------------------------------------
               ESC
            ------------------------------------------------- */

            document.addEventListener(
                'keydown',
                function (event) {

                    if (
                        event.key === 'Escape'
                        &&
                        modal.classList.contains(
                            'show'
                        )
                    ) {

                        closeDeleteModal();

                    }

                }
            );


            /* -------------------------------------------------
               CLOSE
            ------------------------------------------------- */

            function closeDeleteModal() {

                modal.classList.remove(
                    'show'
                );

                modal.setAttribute(
                    'aria-hidden',
                    'true'
                );

                document.body.style.overflow =
                    '';

                selectedForm = null;

                confirmButton.disabled =
                    false;

                confirmButton.textContent =
                    'Yes, Delete';

            }

        }
    );

</script>

@stack('scripts')

</body>

</html>





























