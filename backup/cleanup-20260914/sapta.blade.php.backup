        .sapta-sidebar.collapsed:hover .sidebar-account-title,
        .sapta-sidebar.collapsed:hover .sidebar-account-subtitle,
        .sapta-sidebar.collapsed:hover .sidebar-section-title {
            display: block;
        }
        
        .sapta-sidebar.collapsed:hover .sidebar-single-link,
        .sapta-sidebar.collapsed:hover .sidebar-menu-button {
            justify-content: space-between;
            padding: 8px 14px;
        }
        
        .sapta-sidebar.collapsed:hover .sidebar-menu-left {
            justify-content: flex-start;
