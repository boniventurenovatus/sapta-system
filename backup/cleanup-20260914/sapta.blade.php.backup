        /* FORCE ALL FORMS TO TOP */
        .sapta-content {
            padding-top: 0 !important;
            padding-bottom: 0 !important;
            margin-top: 0 !important;
            display: block !important;
        }
        
        .sapta-container {
            padding-top: 0 !important;
            margin-top: 0 !important;
        }
        
        /* Remove any scroll hiding */
        .form-container,
        .form-wrapper {
            max-height: none !important;
            overflow: visible !important;
        }
        
        /* Push content up */
        .sapta-main-area {
            padding-top: 60px !important;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Montserrat', sans-serif; background: #f0f2f5; color: #1a1a2e; min-height: 100vh; }
        
        .sapta-app { display: flex; min-height: 100vh; }
        
        .sapta-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 260px;
            background: #1a1a2e;
            color: #a8b2c1;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            overflow: hidden;
            transition: transform 0.3s ease;
        }
        
        .sapta-brand {
            flex-shrink: 0;
            padding: 20px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            background: #1a1a2e;
        }
        .sapta-brand a { display: flex; flex-direction: column; text-decoration: none; }
        .sapta-brand .brand-title { font-size: 20px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; }
        .sapta-brand .brand-title span { color: #4fc3f7; }
        .sapta-brand .brand-sub { font-size: 10px; color: #6b7a8f; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }
        
        .sapta-sidebar-scroll { flex: 1;  padding: 12px 16px 20px; }
        .sidebar-section-title { font-size: 10px; font-weight: 700; color: #4a5a6f; text-transform: uppercase; letter-spacing: 0.8px; padding: 12px 12px 6px; }
        
        .sidebar-single-link, .sidebar-menu-button {
            width: 100%; min-height: 40px; display: flex; align-items: center; justify-content: space-between;
            gap: 10px; padding: 8px 12px; border-radius: 8px; color: #a8b2c1; font-size: 14px;
            font-weight: 500; transition: all 0.2s ease; text-align: left; text-decoration: none !important;
        }
        .sidebar-single-link:hover, .sidebar-menu-button:hover { background: rgba(255,255,255,0.06); color: #ffffff; text-decoration: none !important; }
        .sidebar-single-link.active, .sidebar-menu-button.active { background: rgba(79, 195, 247, 0.12); color: #4fc3f7; font-weight: 600; }
        
        .sidebar-menu-left { display: flex; align-items: center; gap: 12px; min-width: 0; }
        .sidebar-menu-icon { width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #6b7a8f; }
        .sidebar-menu-icon svg { width: 18px; height: 18px; }
        .sidebar-menu-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .sidebar-chevron { width: 16px; height: 16px; flex-shrink: 0; transition: transform 0.25s ease; color: #4a5a6f; }
        .sidebar-chevron.rotate { transform: rotate(180deg); }
        
        .sidebar-submenu { display: none; margin: 4px 0 6px 32px; padding-left: 16px; border-left: 2px solid rgba(255,255,255,0.06); }
        .sidebar-submenu.open { display: block; }
        .sidebar-submenu-link {
            min-height: 34px; display: flex; align-items: center; padding: 4px 12px; border-radius: 6px;
            color: #8898aa; font-size: 13px; font-weight: 500; transition: all 0.15s ease; text-decoration: none !important;
        }
        .sidebar-submenu-link:hover { background: rgba(255,255,255,0.05); color: #ffffff; text-decoration: none !important; }
        .sidebar-submenu-link.active { background: rgba(79, 195, 247, 0.08); color: #4fc3f7; font-weight: 600; }
        .sidebar-submenu-label { font-size: 9px; font-weight: 700; color: #4a5a6f; text-transform: uppercase; letter-spacing: 0.8px; padding: 6px 12px 2px; }
        
        .sapta-sidebar-footer { flex-shrink: 0; padding: 12px 16px; border-top: 1px solid rgba(255,255,255,0.06); background: #1a1a2e; }
        .sidebar-account-link { display: flex; align-items: center; gap: 12px; padding: 8px 12px; border-radius: 8px; color: #a8b2c1; transition: all 0.15s; text-decoration: none !important; }
        .sidebar-account-link:hover { background: rgba(255,255,255,0.06); color: #ffffff; text-decoration: none !important; }
        .sidebar-account-icon { width: 36px; height: 36px; border-radius: 8px; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; color: #a8b2c1; flex-shrink: 0; }
        .sidebar-account-icon svg { width: 18px; height: 18px; }
        .sidebar-account-title { font-size: 13px; font-weight: 600; color: #ffffff; }
        .sidebar-account-subtitle { font-size: 11px; color: #6b7a8f; }
        
        .sapta-main-area {
            margin-left: 270px;
            flex: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: #f0f2f5;
            padding-top: 64px; margin-left: 260px; flex: 1; min-height: 100vh; display: flex; flex-direction: column; background: #f0f2f5; }
        
        .sapta-topbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            min-height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            background: #ffffff;
            border-bottom: 1px solid #e8ecf1;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            flex-shrink: 0;
            position: sticky; top: 0; z-index: 100; min-height: 56px; display: flex; align-items: center;
            justify-content: space-between; padding: 0 20px; background: #ffffff; border-bottom: 1px solid #e8ecf1;
            box-shadow: 0 1px 4px rgba(0,0,0,0.04); flex-shrink: 0;
        }
        .topbar-left { display: flex; align-items: center; gap: 16px; flex: 1; min-width: 0; }
        .topbar-right { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
        
        .topbar-logo-icon { width: 42px; height: 42px; border-radius: 10px; background: #1a1a2e; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 22px; flex-shrink: 0; }
        .topbar-logo-text { font-size: 20px; font-weight: 800; color: #1a1a2e; letter-spacing: -0.5px; }
        .topbar-logo-text span { color: #1a5276; }
        .topbar-logo-sub { font-size: 9px; color: #8898aa; text-transform: uppercase; letter-spacing: 0.5px; }
        
        .lang-switcher { display: flex; gap: 4px; background: #f0f2f5; padding: 4px; border-radius: 8px; border: 1px solid #e8ecf1; }
        .lang-switcher button { padding: 6px 14px; border-radius: 6px; border: none; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; background: transparent; color: #8898aa; }
        .lang-switcher button.active { background: white; color: #1a5276; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
        .lang-switcher button:hover { opacity: 0.8; }
        
        .topbar-user { display: flex; align-items: center; gap: 12px; padding: 4px 12px 4px 4px; border-radius: 10px; transition: all 0.2s; cursor: pointer; }
        .topbar-user:hover { background: #f8f9fa; }
        .topbar-avatar { width: 38px; height: 38px; border-radius: 50%; background: #1a5276; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; flex-shrink: 0; overflow: hidden; }
        .topbar-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .topbar-user-name { font-size: 14px; font-weight: 600; color: #1a1a2e; }
        .topbar-user-role { font-size: 12px; color: #8898aa; }
        .topbar-date { font-size: 13px; color: #8898aa; padding-left: 16px; border-left: 1px solid #e8ecf1; white-space: nowrap; }
        
        .sapta-content {
            flex: 1;
            padding: 5px 10px;
            width: 100%;
            
            height: calc(100vh - 64px); flex: 1; padding: 5px 10px; width: 100%; }
        .sapta-container { max-width: 1200px; margin: 0 auto; width: 100%; }
        
        .sapta-footer { flex-shrink: 0; padding: 16px 32px; border-top: 1px solid #e8ecf1; background: #fff; color: #8898aa; font-size: 13px; text-align: center; }
        
        .alert-error { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 14px 18px; border-radius: 10px; margin-bottom: 20px; }
        .alert-success { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 14px 18px; border-radius: 10px; margin-bottom: 20px; }
        
        .mobile-menu-button { display: none; width: 40px; height: 40px; border: 2px solid #e8ecf1; border-radius: 10px; background: #fff; align-items: center; justify-content: center; color: #1a1a2e; }
        .mobile-menu-button:hover { background: #f8f9fa; border-color: #1a5276; }
        .sapta-sidebar-overlay { display: none; position: fixed; inset: 0; z-index: 999; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); }
        .sapta-sidebar-overlay.show { display: block; }
        
        @media (max-width: 768px) {
            .sapta-sidebar { transform: translateX(-100%); width: 280px; }
            .sapta-sidebar.mobile-open { transform: translateX(0); }
            .sapta-sidebar-overlay.show { display: block; }
            .sapta-main-area {
            margin-left: 270px;
            flex: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: #f0f2f5;
            padding-top: 64px; margin-left: 0; width: 100%; }
            .mobile-menu-button { display: inline-flex; }
