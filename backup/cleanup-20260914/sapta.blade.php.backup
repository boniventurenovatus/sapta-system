<script>
    var currentLang = localStorage.getItem('sapta_lang') || 'en';
    
    function setLanguage(lang) {
        currentLang = lang;
        localStorage.setItem('sapta_lang', lang);
        
        document.getElementById('langEn').className = lang === 'en' ? 'active' : '';
        document.getElementById('langSw').className = lang === 'sw' ? 'active' : '';
        
        document.querySelectorAll('[data-en][data-sw]').forEach(function(el) {
            if (lang === 'en') {
                el.textContent = el.getAttribute('data-en');
            } else {
                el.textContent = el.getAttribute('data-sw');
            }
        });
        
        document.querySelectorAll('textarea[data-en-placeholder][data-sw-placeholder]').forEach(function(el) {
            if (lang === 'en') {
                el.placeholder = el.getAttribute('data-en-placeholder');
            } else {
                el.placeholder = el.getAttribute('data-sw-placeholder');
            }
        });
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        setLanguage(currentLang);
    });
    
    function toggleSidebarMenu(menuId, button) {
        const menu = document.getElementById(menuId);
        if (!menu) return;
        const isOpen = menu.classList.contains('open');
        document.querySelectorAll('.sidebar-submenu.open').forEach(el => {
            if (el.id !== menuId) {
                el.classList.remove('open');
                const btn = el.previousElementSibling;
                if (btn) {
                    const ch = btn.querySelector('.sidebar-chevron');
                    if (ch) ch.classList.remove('rotate');
                }
            }
        });
        if (isOpen) {
            menu.classList.remove('open');
        } else {
            menu.classList.add('open');
        }
        const chevron = button.querySelector('.sidebar-chevron');
        if (chevron) chevron.classList.toggle('rotate', !isOpen);
    }

    function openMobileSidebar() {
        document.getElementById('saptaSidebar').classList.add('mobile-open');
        document.getElementById('saptaSidebarOverlay').classList.add('show');
        document.body.style.overflow = 'hidden';
    }
    function closeMobileSidebar() {
        document.getElementById('saptaSidebar').classList.remove('mobile-open');
        document.getElementById('saptaSidebarOverlay').classList.remove('show');
        document.body.style.overflow = '';
    }
</script>

</body>
</html>





















































