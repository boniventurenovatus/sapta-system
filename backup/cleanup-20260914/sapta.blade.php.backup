            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            flex-shrink: 0; padding: 0 16px; min-height: 60px; flex-wrap: wrap; }
            .sapta-content {
            flex: 1;
            padding: 5px 10px;
            width: 100%;
            
            height: calc(100vh - 64px); padding: 16px; }
            .topbar-date { display: none; }
            .topbar-user-info { display: none; }
        }
            
        /* ==================== STANDARDIZED FONT SIZES - eGA COMPLIANT ==================== */
        
        /* Base - 16px = 1rem */
        html { font-size: 16px; }
        
        /* Body Text - 16px */
        body {
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
            line-height: 1.6;
            color: #1a1a2e;
        }
        
        /* Headings */
        h1 { font-size: 2rem; font-weight: 700; }      /* 32px */
        h2 { font-size: 1.75rem; font-weight: 700; }   /* 28px */
        h3 { font-size: 1.5rem; font-weight: 600; }    /* 24px */
        h4 { font-size: 1.25rem; font-weight: 600; }   /* 20px */
        h5 { font-size: 1.125rem; font-weight: 600; }  /* 18px */
        h6 { font-size: 1rem; font-weight: 600; }      /* 16px */
        
        /* Paragraphs */
        p { font-size: 1rem; line-height: 1.6; }       /* 16px */
        
        /* Small Text - 14px */
        .text-small,
        small,
        .small-text { font-size: 0.875rem; }           /* 14px */
        
        /* Very Small Text - 12px */
        .text-xs,
        .very-small { font-size: 0.75rem; }            /* 12px */
        
        /* ==================== SIDEBAR ==================== */
        .sidebar-section-title {
            font-size: 0.625rem;                       /* 10px */
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #4a5a6f;
        }
        .sidebar-single-link,
        .sidebar-menu-button {
            font-size: 0.875rem;                       /* 14px */
            font-weight: 500;
        }
        .sidebar-menu-text {
            font-size: 0.875rem;                       /* 14px */
        }
        .sidebar-submenu-link {
            font-size: 0.8125rem;                      /* 13px */
            font-weight: 500;
        }
        .sidebar-submenu-label {
            font-size: 0.5625rem;                      /* 9px */
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .sidebar-account-title {
            font-size: 0.8125rem;                      /* 13px */
            font-weight: 600;
        }
        .sidebar-account-subtitle {
            font-size: 0.6875rem;                      /* 11px */
        }
        
        /* ==================== TOPBAR ==================== */
        .topbar-logo-text {
            font-size: 1.25rem;                        /* 20px */
            font-weight: 800;
        }
        .topbar-logo-sub {
            font-size: 0.5625rem;                      /* 9px */
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .topbar-search input {
            font-size: 0.875rem;                       /* 14px */
        }
        .topbar-lang {
            font-size: 0.8125rem;                      /* 13px */
            font-weight: 600;
        }
        .topbar-user-name {
            font-size: 0.875rem;                       /* 14px */
            font-weight: 600;
        }
        .topbar-user-role {
            font-size: 0.75rem;                        /* 12px */
        }
        .topbar-date {
            font-size: 0.8125rem;                      /* 13px */
        }
        
        /* ==================== BUTTONS ==================== */
        .btn {
            font-size: 0.875rem;                       /* 14px */
            font-weight: 600;
        }
        .btn-sm { font-size: 0.8125rem; }              /* 13px */
        .btn-lg { font-size: 1rem; }                   /* 16px */
        
        /* ==================== FORMS ==================== */
        .form-label {
            font-size: 0.875rem;                       /* 14px */
            font-weight: 600;
        }
        .form-control,
        .form-control input,
        .form-control select,
        .form-control textarea {
            font-size: 1rem;                           /* 16px - prevents iOS zoom */
            font-family: 'Montserrat', sans-serif;
        }
        .form-control::placeholder {
            font-size: 0.875rem;                       /* 14px */
        }
        .help-text,
        .form-text {
            font-size: 0.8125rem;                      /* 13px */
        }
        
        /* ==================== TABLES ==================== */
        .table th {
            font-size: 0.75rem;                        /* 12px */
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .table td {
            font-size: 0.875rem;                       /* 14px */
        }
        .table .badge {
            font-size: 0.75rem;                        /* 12px */
            font-weight: 600;
        }
        
        /* ==================== CARDS ==================== */
        .card-title {
            font-size: 1.125rem;                       /* 18px */
            font-weight: 600;
        }
        .card-subtitle {
            font-size: 0.875rem;                       /* 14px */
        }
        .card-text {
            font-size: 0.875rem;                       /* 14px */
        }
        
        /* ==================== STATS ==================== */
        .stat-number {
            font-size: 1.75rem;                        /* 28px */
            font-weight: 800;
        }
        .stat-label {
            font-size: 0.8125rem;                      /* 13px */
            font-weight: 500;
        }
        
        /* ==================== BADGES ==================== */
        .badge {
            font-size: 0.75rem;                        /* 12px */
            font-weight: 600;
        }
        
        /* ==================== FOOTER ==================== */
        .footer-text,
        .sapta-footer {
            font-size: 0.8125rem;                      /* 13px */
        }
        
        /* ==================== BREADCRUMBS ==================== */
        .breadcrumb {
            font-size: 0.875rem;                       /* 14px */
        }
        
        /* ==================== MODALS ==================== */
        .modal-title {
            font-size: 1.25rem;                        /* 20px */
            font-weight: 700;
        }
        .modal-body {
            font-size: 0.875rem;                       /* 14px */
        }
        
        /* ==================== DASHBOARD ==================== */
        .dashboard-stat-number {
            font-size: 1.75rem;                        /* 28px */
            font-weight: 800;
        }
        .dashboard-stat-label {
            font-size: 0.8125rem;                      /* 13px */
            font-weight: 500;
        }
        .quick-action-btn .label {
            font-size: 0.6875rem;                      /* 11px */
            font-weight: 500;
        }
        .activity-info .title {
            font-size: 0.875rem;                       /* 14px */
            font-weight: 500;
        }
        .activity-info .desc {
            font-size: 0.75rem;                        /* 12px */
        }
        .activity-time {
            font-size: 0.6875rem;                      /* 11px */
        }
        
        /* ==================== NOTIFICATIONS ==================== */
        .notification-item .content .text {
            font-size: 0.8125rem;                      /* 13px */
        }
        .notification-item .content .time {
            font-size: 0.6875rem;                      /* 11px */
        }
        
        /* ==================== PAGINATION ==================== */
        .pagination {
            font-size: 0.875rem;                       /* 14px */
        }
        
        /* ==================== CHARTS ==================== */
        .chart-label {
            font-size: 0.625rem;                       /* 10px */
        }
        .chart-legend {
            font-size: 0.75rem;                        /* 12px */
        }
        
        /* ==================== EMPLOYEE FORM ==================== */
        .section-title {
            font-size: 1.125rem;                       /* 18px */
            font-weight: 700;
        }
        
        /* ==================== RESPONSIVE ==================== */
        @media (max-width: 768px) {
            h1 { font-size: 1.75rem; }                 /* 28px */
            h2 { font-size: 1.5rem; }                  /* 24px */
            h3 { font-size: 1.25rem; }                 /* 20px */
            h4 { font-size: 1.125rem; }                /* 18px */
            .stat-number { font-size: 1.5rem; }        /* 24px */
            .dashboard-stat-number { font-size: 1.5rem; } /* 24px */
        }
        
        @media (max-width: 480px) {
            h1 { font-size: 1.5rem; }                  /* 24px */
            h2 { font-size: 1.25rem; }                 /* 20px */
            .stat-number { font-size: 1.25rem; }       /* 20px */
            .dashboard-stat-number { font-size: 1.25rem; } /* 20px */
        }
            
        /* Fix scrolling issues */
        .sapta-main-area {
            margin-left: 270px;
            flex: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: #f0f2f5;
            padding-top: 64px;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }
        
        .sapta-content {
            flex: 1;
            padding: 5px 10px;
            width: 100%;
            
            height: calc(100vh - 64px);
            flex: 1;
            
            padding: 5px 10px;
        }
        
        .sapta-topbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            min-height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            background: #ffffff;
            border-bottom: 1px solid #e8ecf1;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            flex-shrink: 0;
            flex-shrink: 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        .sapta-footer {
            flex-shrink: 0;
        }
        
        /* Fix for collapsed sidebar */
        .sapta-main-area.expanded {
            margin-left: 70px;
            margin-left: 70px;
        }
            
        /* FORM CONTAINER - Short Scroll */
        .form-container {
            
            
            padding: 20px 24px;
            background: white;
            border-radius: 16px;
            border: 1px solid #e8ecf1;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }
        
        .form-container::-webkit-scrollbar {
            width: 6px;
        }
        
        .form-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        
        .form-container::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 10px;
        }
        
        /* Form sections */
        .form-section {
            background: white;
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 16px;
            border: 1px solid #f0f2f5;
        }
        
        .form-section:last-child {
            margin-bottom: 0;
        }
        
        .form-section .section-title {
            font-size: 15px;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 2px solid #e8ecf1;
        }
        
        /* Form fields */
        .form-group {
            margin-bottom: 14px;
        }
        
        .form-group label {
            display: block;
            font-weight: 600;
            color: #1a1a2e;
            margin-bottom: 4px;
            font-size: 13px;
        }
        
        .form-group label .required {
            color: #dc2626;
            margin-left: 4px;
        }
        
        .form-group .form-control {
            width: 100%;
            padding: 8px 12px;
            border: 2px solid #e8ecf1;
            border-radius: 8px;
            font-size: 14px;
            color: #1a1a2e;
            background: #f8f9fa;
            transition: all 0.3s ease;
            outline: none;
        }
        
        .form-group .form-control:focus {
            border-color: #1a5276;
            background: white;
            box-shadow: 0 0 0 4px rgba(26, 82, 118, 0.08);
        }
        
        .form-group .form-control::placeholder {
            color: #a8b2c1;
        }
        
        .form-group textarea.form-control {
            resize: vertical;
            min-height: 60px;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        
        .form-actions {
            display: flex;
            gap: 12px;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid #e8ecf1;
        }
        
        .form-actions .btn {
            padding: 8px 24px;
            border-radius: 8px;
            border: none;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        
        .form-actions .btn-primary {
            background: linear-gradient(135deg, #1a5276, #2d8a9e);
            color: white;
            box-shadow: 0 4px 15px rgba(26, 82, 118, 0.2);
        }
        
        .form-actions .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(26, 82, 118, 0.3);
            color: white;
        }
        
        .form-actions .btn-secondary {
            background: #e8ecf1;
            color: #4a5a6f;
        }
        
        .form-actions .btn-secondary:hover {
            background: #d5d9e0;
            color: #1a1a2e;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
            .form-container {
                
                padding: 12px 16px;
            }
            .form-actions {
                flex-direction: column;
            }
            .form-actions .btn {
                width: 100%;
                justify-content: center;
            }
        }
            
        /* MASTER FORM STYLES - PUSH TO TOP */
        .form-container,
        .form-wrapper,
        .emp-form-container,
        .project-form-container,
        .attendance-form-container,
        .leave-form-container {
            max-width: 800px !important;
            margin: 0 auto !important;
            padding: 10px 15px 8px !important;
            background: white !important;
            border-radius: 10px !important;
            border: 1px solid #e8ecf1 !important;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04) !important;
        }
        
        /* Remove any centering that pushes forms down */
        .sapta-content {
            padding-top: 0 !important;
            display: block !important;
            align-items: flex-start !important;
        }
        
        .sapta-container {
            padding-top: 0 !important;
            margin-top: 0 !important;
        }
        
        /* Forms should start from top */
        .sapta-main-area .sapta-content .sapta-container {
            padding-top: 5px !important;
        }
    </style>
</head>
